class_name HullStats
extends Resource
## One shared definition; runtime HP/speed always belong to each ship instance.
@export var title: String = "Sloop"
@export var max_health: float = 100.0
@export var top_speed: float = 180.0
@export var reverse_speed: float = 45.0
@export var acceleration: float = 95.0
@export var drag: float = 48.0
@export var turn_rate: float = 1.6
