{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Dock",
  "version": "0.1.0",
  "identifier": "com.gamedock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Game Dock",
        "width": 1250,
        "height": 840,
        "minWidth": 870,
        "minHeight": 640,
        "backgroundColor": "#101922"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
