{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Dock Local Game Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "executable"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "genre": {
      "type": "string",
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "executable": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_. -]+\\.exe$",
      "maxLength": 128
    }
  }
}
